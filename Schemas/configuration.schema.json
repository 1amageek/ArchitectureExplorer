{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "swift",
          "rust"
        ]
      },
      "minItems": 1
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "syntax": {
          "type": "boolean"
        },
        "semantic": {
          "enum": [
            "onDemand",
            "disabled"
          ]
        },
        "cfg": {
          "enum": [
            "onDemand",
            "disabled"
          ]
        },
        "debounceMilliseconds": {
          "type": "integer",
          "minimum": 50,
          "maximum": 10000
        },
        "maxWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxSourceFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      },
      "additionalProperties": false
    },
    "views": {
      "type": "object"
    },
    "designGroups": {
      "type": "array"
    },
    "externalLinks": {
      "type": "array"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "languages"
  ],
  "additionalProperties": false
}
