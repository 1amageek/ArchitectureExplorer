{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation.schema.json",
  "title": "External annotation report / aex-1.3",
  "type": "object",
  "properties": {
    "reportedStatus": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "translationStatus": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 128
    },
    "attributes": {
      "type": "object",
      "maxProperties": 64
    }
  },
  "additionalProperties": false,
  "required": [
    "reportedStatus",
    "claim",
    "scope",
    "translationStatus",
    "assumptions",
    "evidence",
    "attributes"
  ]
}
